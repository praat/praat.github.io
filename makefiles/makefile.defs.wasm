# File: makefile.defs.wasm
# System: WebAssembly via Emscripten (no GUI, network, graphics, or sound)
# For building praat-wasm: a headless Praat library for browser/Node.js use

CC = emcc
CXX = em++
LINK = $(CXX)

COMMONFLAGS = -DNO_GRAPHICS -DNO_NETWORK -DNO_AUDIO -D_FILE_OFFSET_BITS=64 -DUNIX -Dlinux \
	-DWORDS_BIGENDIAN=0 -DPA_LITTLE_ENDIAN \
	-Wreturn-type -Wunused -Wunused-parameter -Wuninitialized -Oz \
	-fexceptions -flto

CFLAGS = -std=gnu99 $(COMMONFLAGS) -Werror=missing-prototypes -Werror=implicit

CXXFLAGS = -std=c++17 $(COMMONFLAGS) -Wshadow

EXECUTABLE = praat.mjs

LDFLAGS_WASM = -s WASM=1 \
	-s ALLOW_MEMORY_GROWTH=1 \
	-s MODULARIZE=1 \
	-s EXPORT_ES6=1 \
	-s EXPORT_NAME=PraatModule \
	-s EXPORTED_RUNTIME_METHODS='["ccall","cwrap","FS","UTF8ToString","stringToUTF8","lengthBytesUTF8"]' \
	-s ENVIRONMENT='web,worker,node' \
	-s FILESYSTEM=1 \
	-s NO_EXIT_RUNTIME=1 \
	-s NO_DISABLE_EXCEPTION_CATCHING \
	-s STACK_SIZE=8388608 \
	--bind

LIBS = $(LDFLAGS_WASM)

AR = emar
RANLIB = emranlib
ICON =
MAIN_ICON =

INSTALL =
